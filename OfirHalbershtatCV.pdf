nyLogo":"https://enhancv.s3.amazonaws.com/company-logos/0efea2bae48eb0f501164bb11137991db5fb47ed471725af864647983a13a426.jpg","description":"Directed the organizationâ€™s information security strategy, while governing security policies, cloud protections, and DevSecOps integration. Forged partnerships with IT and business units to embed security into operations, driving secure digital transformation and quantifiable risk reduction.","link":"","location":"Remote","position":"Chief Information Security Officer (CISO)","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Orbia: Koura, Alphagary, and Vestolit"},{"dateRange":{"fromMonth":null,"fromYear":2017,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":null,"toYear":2020},"table":{"cols":2,"record":"TableItem","rows":[]},"height":206,"id":"m475xdiy1o","record":"ExperienceItem","alignment":"left","bullets":["Founded and led Cloud Security Consulting Services, delivering Cloud Security Assessment, Architecture Design, and Cloud Compliance &amp;amp; Governance Implementation.","Delivered CISO-as-a-Service by designing security governance programs, establishing security policies, and coordinating vulnerability management to protect enterprise systems and assets from cyber threats.","Performed security risk analyses on information systems or applications, identified vulnerabilities, recommended remediation measures, and supervised implementation."],"companyLogo":"https://enhancv.s3.amazonaws.com/company-logos-cache/bdo.co.il.png","description":"Secoz security center","link":"","location":"Tel Aviv-Yafo, Israel","position":"Senior Security Consultant","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"BDO Israel, Secoz security center"},{"dateRange":{"fromMonth":null,"fromYear":2015,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":null,"toYear":2017},"table":{"cols":2,"record":"TableItem","rows":[["&lt;b&gt;Project name&lt;/b&gt;","&lt;b&gt;Description&lt;/b&gt;"],["",""]]},"height":269,"id":"of0m0ec6ll","record":"ExperienceItem","alignment":"left","bullets":["Manage computing infrastructure and information security for financial and fintech organizations across on-premises and cloud environments.","Design and implement disaster recovery solutions using multiple cloud services.","Integrate secure monitoring solutions.","Deploy and manage endpoint detection and response (EDR) systems.","Develop, implement, and enforce data security policies.","Maintain and deploy the network and firewall solutions to ensure high availability and data security.","Design and implement mobile security policies and technical controls.","Establish, integrate, and maintain DevOps development environments."],"companyLogo":"https://enhancv.s3.amazonaws.com/company-logos-cache/sage.co.il.png","description":"Manage computing infrastructure and information security for financial and fintech organizations across on-premises and cloud environments.","link":"","location":"Ramat Gan, Israel","position":"Security Systems Administrator","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Sage Group Ltd"}],"name":"","record":"ExperienceSection","showCompanyLogos":true,"timelineWidth":136},{"__t":"EducationSection","column":1,"enabled":true,"height":30,"items":[{"dateRange":{"fromMonth":null,"fromYear":2000,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":null,"toYear":2004},"height":67,"id":"jdw9x964nk","record":"EducationItem","alignment":"left","bullets":[],"companyLogo":"","degree":"Computer Science","gpa":"","gpaText":"","institution":"The Open University","location":"Ramat Gan, Israel","maxGpa":"","showBullets":false,"showDateRange":true,"showGpa":false,"showInstitution":true,"showLocation":true}],"name":"","record":"EducationSection","showCompanyLogos":false,"timelineWidth":136},{"__t":"CourseSection","column":1,"enabled":true,"height":30,"items":[{"height":47,"id":"n84ba3ewvf","record":"CourseItem","alignment":"left","description":"John Bryce","showDescription":true,"title":"2019 - AWS Architect"},{"height":47,"id":"lwdlc5hboq","record":"CourseItem","alignment":"left","description":"Cloud Security Alliance","showDescription":true,"title":"2018 - Cloud Security Knowledge (CCSK)"},{"height":46,"id":"b50iphccpp","record":"CourseItem","alignment":"left","description":"John Bryce","showDescription":true,"title":"2014 - VMware vSphere"}],"name":"","record":"CourseSection"},{"__t":"LanguageSection","column":1,"enabled":true,"height":30,"items":[{"height":43,"id":"gxl1df3q0c","record":"LanguageItem","level":5,"levelText":"Native","name":"Hebrew"},{"height":42,"id":"uyyr9txn2k","record":"LanguageItem","level":4,"levelText":"Excellent","name":"English"}],"name":"","record":"LanguageSection","indicatorType":"dots","showProficiency":true,"showSlider":true},{"__t":"TechnologySection","column":1,"enabled":true,"height":30,"items":[{"height":227,"id":"kl7zgrh8hc","record":"TechnologyItem","description":"","showTitle":false,"tags":["Leadership","Cloud Security","IR","Risk Management","IAM","Data Protection","VM","Zero Trust","SSDLC","CI/CD","AWS","Azure","Microsoft 365 security","SCA","SecOps","SASE","CSPM","Programming and Scripting","ASPM"],"title":""}],"name":"","record":"TechnologySection","compactMode":false,"surroundingBorder":false}],"user":"6900dd74474bde71eff3fa2a"}</pdfx:ecv-data>
